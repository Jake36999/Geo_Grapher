{
  "name": "geo-grapher-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "contracts": "node scripts/generate-contracts.cjs",
    "build": "tsc -p frontend/tsconfig.json --noEmit && vite build --config frontend/vite.config.ts",
    "dev": "vite --config frontend/vite.config.ts",
    "typecheck": "tsc -p frontend/tsconfig.json --noEmit",
    "test:browser": "node scripts/browser-workflows.cjs",
    "benchmark:http": "node scripts/benchmark-http.cjs",
    "benchmark:browser": "node scripts/browser-reference.cjs",
    "test:ui": "npm run build && playwright test --config playwright.config.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "type": "module"
}
